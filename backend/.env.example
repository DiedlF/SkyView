# SkyView environment template — copy to backend/.env and fill in the values.
#
#   cp backend/.env.example backend/.env
#   chmod 600 backend/.env
#
# This template (placeholders only) IS committed. The real backend/.env is
# gitignored and must never be committed. The backend loads backend/.env at
# startup (see backend/app.py:_load_env_file); real shell environment
# variables take precedence over file values.

# ── Marker auth (HMAC signing of marker tokens) ────────────────────────────
# Generate: openssl rand -hex 32   (min 16 chars; 32+ recommended)
SKYVIEW_MARKER_AUTH_SECRET=""

# ── Admin / private ops (HTTP Basic) ───────────────────────────────────────
SKYVIEW_ADMIN_USER=""
SKYVIEW_ADMIN_PASSWORD=""

# ── Production CORS allowlist (comma-separated origins) ─────────────────────
# Unset = localhost only (dev). Set real public origins before any public deploy.
SKYVIEW_CORS_ORIGINS=""

# ── EUMETSAT Data Store (observation layer: MSG RSS / MTG satellite) ───────
# API key PAIR from https://user.eumetsat.int  →  "API key" page.
# These are NOT your portal username/password. Treat them as long-lived secrets.
# Verify them with:  python3 scripts/eumetsat_auth.py
EUMETSAT_CONSUMER_KEY=""
EUMETSAT_CONSUMER_SECRET=""
# Optional: override the satellite collection (default = MSG RSS, 5-min Europe).
#   MSG RSS L1.5:  EO:EUM:DAT:MSG:MSG15-RSS
#   MTG FCI  L1c:  EO:EUM:DAT:0662   (10-min, migration target)
#EUCOMP_SAT_COLLECTION="EO:EUM:DAT:MSG:MSG15-RSS"
# Optional: override the MTG-I1 FCI comparison layer (default = HRFI vis_06).
#   FCI L1c HRFI  (0.5 km vis_06):  EO:EUM:DAT:0665   (default)
#   FCI L1c FDHSI (1 km vis_06):    EO:EUM:DAT:0662
# Both the MSG RSS and FCI collections need their per-collection NRT licence
# accepted in the Data Store (see docs/OPS_SECRETS.md).
#EUCOMP_MTG_COLLECTION="EO:EUM:DAT:0665"
#EUCOMP_MTG_CHANNEL="vis_06"
# MTG bandwidth control: download only the northern (Europe) chunks of the FCI
# disk. Default keeps the top 35% of body chunks (≈ EUMETSAT "Q4" + margin).
# Lower = less bandwidth but risks clipping the 40°N edge; raise after live QA.
#EUCOMP_MTG_CHUNK_FRACTION="0.35"
# Or pin an explicit chunk range if you know the layout (FDHSI FD: "29-40").
#EUCOMP_MTG_CHUNKS="29-40"
# Optional: override the MTG-I1 Lightning Imager (LI) overlay. Default = the
# gridded Accumulated Flashes (AF) product; small (~2-3 MB/10-min), no subsetting.
#   LI L2 Accumulated Flashes (AF):      EO:EUM:DAT:0686   (default)
#   LI L2 Accumulated Flash Area (AFA):  EO:EUM:DAT:0687
# The LI collection needs its own per-collection NRT licence accepted.
#EUCOMP_LI_COLLECTION="EO:EUM:DAT:0686"
#EUCOMP_LI_DATASET="flash_accumulation"
